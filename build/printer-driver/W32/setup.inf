

; Sample combination printer INF for NT 2000 .
; 

[Version]
Signature="$Windows NT$"
Provider=%SNBC%
LayoutFile=layout.inf
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
DriverVer=03/28/2014,1.10.00.00

[ClassInstall]
AddReg=ClassAddReg
DelReg=ClassDelReg

[ClassDelReg]
HKLM,"System\CurrentControlSet\Services\Class\Printer","NoUseClass"

[ClassAddReg]
HKR,,,,%CLASSNAME%
HKR,,Installer,,MSPRINT.DLL
HKR,,Icon,,-4
HKR,,NoDisplayClass,,1

;
; Manufacturer Sections
;

[Manufacturer]
"SNBC"

;
; Model Sections 
;

[SNBC]
"BTP-R880NP(U)1" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NP(U)1B4D7", "SNBC_BTP-R880NP(U)1B4D7"
"BTP-R880NP(U)2" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NP(U)2B597", "SNBC_BTP-R880NP(U)2B597"
"BTP-R880NP(U)3" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NP(U)37556", "SNBC_BTP-R880NP(U)37556"
"BTP-R880NP(U)4" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NP(U)4B717", "SNBC_BTP-R880NP(U)4B717"

"BTP-R880NPII(U)1" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NPII(U)5318", "SNBC_BTP-R880NPII(U)5318"
"BTP-R880NPII(U)2" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NPII(U)5258", "SNBC_BTP-R880NPII(U)5258"
"BTP-R880NPII(U)3" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NPII(U)9299", "SNBC_BTP-R880NPII(U)9299"
"BTP-R880NPII(U)4" = R880NPxp.GPD, USBPRINT\"SNBC_BTP-R880NPII(U)50D8", "SNBC_BTP-R880NPII(U)50D8"


;
; Installer Sections
;
; 

[R880NPxp.GPD]
CopyFiles=@R880NPxp.DLL,@R880NPxp.GPD
CopyFiles=@R880NPUI.INI
CopyFiles=R880NPUI
CopyFiles=LANGUAGEINI
DataSection=UNIDRV_DATA
Include         = NTPRINT.INF
Needs           = TTFSUB.OEM,UNIDRV_BIDI.OEM


[R880NPUI]
R880NPUNI.DLL
R880NPUI.DLL

[LANGUAGEINI]
LANG_R880NP.dat
CHF_R880NP.res
CHN_R880NP.res
ENG_R880NP.res

; Copy Sections

;
; Data Sections
;
; These sections contain data that is shared between devices.
;

;
; Call SetupSetDirectoryId with 66000 to set the target directory at runtime
; (depending on which environment drivers are getting installed)
;

[DestinationDirs]
DefaultDestDir=66000

;
; diskid = description,tagfile,unused,subdir
;
[SourceDisksNames]
1 = %Floppy%,,,

;
; filename_on_source = diskid,subdir,size,checksum,spare,spare
; extra fields are nt-specific
;   bootmediaord,targetdirectory,upgradedisposition,textmodedisposition,targetname
;
[SourceDisksFiles]
R880NPxp.DLL  = 1
R880NPxp.GPD  = 1
R880NPUNI.DLL = 1
R880NPUI.DLL  = 1
R880NPUI.INI  = 1

LANG_R880NP.dat = 1
CHF_R880NP.res = 1
CHN_R880NP.res = 1
ENG_R880NP.res = 1
;
; Localizable Strings
;
[Strings]
SNBC="Shandong New Beiyang Information Technology Co., Ltd"
Floppy="BY Printer Disk"
CLASSNAME="Printer"
